'SimpleGraph.QuarterFloor.face_table8' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.table_pi' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.cwDarts_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.cw_swap_mod8' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.lemmaW' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.lemmaW_linkFree' depends on axioms: [propext, Classical.choice, Quot.sound]

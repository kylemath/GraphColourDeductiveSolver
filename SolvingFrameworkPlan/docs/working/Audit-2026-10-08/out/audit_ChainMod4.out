'SimpleGraph.QuarterFloor.chainParityLaw_of_F' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.remark7_of_F' depends on axioms: [propext, Classical.choice, Quot.sound]
@[expose] def SimpleGraph.QuarterFloor.fxor : Fin 4 → Fin 4 → Fin 4 :=
fun a b => ![![0, 1, 2, 3], ![1, 0, 3, 2], ![2, 3, 0, 1], ![3, 2, 1, 0]] a b
@[expose] def SimpleGraph.QuarterFloor.isCW : Fin 4 → Fin 4 → Fin 4 → Bool :=
fun x y z => x == 1 && y == 2 && z == 3 || x == 2 && y == 3 && z == 1 || x == 3 && y == 1 && z == 2
@[expose] def SimpleGraph.QuarterFloor.FaceAvoids.{u_1} : {V : Type u_1} →
  {G : SimpleGraph V} → Equiv.Perm G.Dart → V → G.Dart → Prop :=
fun {V} {G} φ h d => d.toProd.1 ≠ h ∧ d.toProd.2 ≠ h ∧ (φ d).toProd.2 ≠ h
@[expose] def SimpleGraph.QuarterFloor.cwAt.{u_1} : {V : Type u_1} →
  {G : SimpleGraph V} → Equiv.Perm G.Dart → (V → Fin 4) → G.Dart → Bool :=
fun {V} {G} φ c d =>
  SimpleGraph.QuarterFloor.isCW (SimpleGraph.QuarterFloor.fxor (c d.toProd.1) (c d.toProd.2))
    (SimpleGraph.QuarterFloor.fxor (c d.toProd.2) (c (φ d).toProd.2))
    (SimpleGraph.QuarterFloor.fxor (c (φ d).toProd.2) (c d.toProd.1))
@[expose] def SimpleGraph.QuarterFloor.cwDarts.{u_1} : {V : Type u_1} →
  [Fintype V] → {G : SimpleGraph V} → [DecidableRel G.Adj] → Equiv.Perm G.Dart → V → (V → Fin 4) → ℕ :=
fun {V} [Fintype V] {G} [DecidableRel G.Adj] φ h c =>
  {d | SimpleGraph.QuarterFloor.FaceAvoids φ h d ∧ SimpleGraph.QuarterFloor.cwAt φ c d = true}.card
@[expose] def SimpleGraph.QuarterFloor.cwCount.{u_1} : {V : Type u_1} →
  [Fintype V] → {G : SimpleGraph V} → [DecidableRel G.Adj] → Equiv.Perm G.Dart → V → (V → Fin 4) → ℕ :=
fun {V} [Fintype V] {G} [DecidableRel G.Adj] φ h c => SimpleGraph.QuarterFloor.cwDarts φ h c / 3
@[expose] def SimpleGraph.QuarterFloor.linkInner.{u_1} : {V : Type u_1} →
  {G : SimpleGraph V} → {h : V} → SimpleGraph.QuarterFloor.Pent G h → Set V → ℕ :=
fun {V} {G} {h} P X => {i | P.x i ∈ X ∧ P.x (i + 1) ∈ X}.card
@[expose] def SimpleGraph.QuarterFloor.LinkBalanced.{u_1} : {V : Type u_1} →
  {G : SimpleGraph V} → {h : V} → SimpleGraph.QuarterFloor.Pent G h → (V → Fin 4) → Fin 4 → Fin 4 → Set V → Prop :=
fun {V} {G} {h} P c p q X =>
  SimpleGraph.QuarterFloor.linkTerm (fun k => decide (P.x k ∈ X)) (fun k => c (P.x k))
      (SimpleGraph.QuarterFloor.fxor p q) 1 =
    0
@[expose] def SimpleGraph.QuarterFloor.handB.{u_1} : {V : Type u_1} →
  {G : SimpleGraph V} → {h : V} → SimpleGraph.QuarterFloor.Pent G h → (V → Fin 4) → Fin 5 → Bool :=
fun {V} {G} {h} P c j =>
  SimpleGraph.QuarterFloor.isCW (SimpleGraph.QuarterFloor.fxor (c (P.x j)) (c (P.x (j + 1))))
    (SimpleGraph.QuarterFloor.fxor (c (P.x j)) (c (P.x (j + 3))))
    (SimpleGraph.QuarterFloor.fxor (c (P.x j)) (c (P.x (j + 4))))
@[expose] def SimpleGraph.QuarterFloor.handS : {n : ℕ} →
  (M : SimpleGraph.SphericalMap n) →
    {h : Fin n} → SimpleGraph.QuarterFloor.Pent M.graph h → (Fin n → Fin 4) → Fin 5 → Bool :=
fun {n} M {h} P c j =>
  if (M.rotation.faceNext { fst := h, snd := P.x 0, adj := ⋯ }).toProd.2 = P.x 1 then
    SimpleGraph.QuarterFloor.handB P c j
  else !SimpleGraph.QuarterFloor.handB P c j
@[expose] def SimpleGraph.QuarterFloor.ChainFormulaF : {n : ℕ} →
  (M : SimpleGraph.SphericalMap n) → {h : Fin n} → SimpleGraph.QuarterFloor.Pent M.graph h → Prop :=
fun {n} M {h} P =>
  ∀ (c : Fin n → Fin 4) (j : Fin 5),
    SimpleGraph.VacancySlide.ProperOff M.graph h c →
      SimpleGraph.QuarterFloor.RepeatAt P c j →
        2 * ↑(SimpleGraph.QuarterFloor.nChains M.graph h c) =
          (↑(SimpleGraph.QuarterFloor.cwCount M.rotation.faceNext h c) + (↑n - 1) -
              if SimpleGraph.QuarterFloor.handS M P c j = true then 1 else 0) +
            2 *
              ((if SimpleGraph.QuarterFloor.Lock1 P c j then 1 else 0) +
                if SimpleGraph.QuarterFloor.Lock2 P c j then 1 else 0)
@[expose] def SimpleGraph.QuarterFloor.ConjectureF : Prop :=
∀ (n : ℕ) (M : SimpleGraph.SphericalMap n) (h : Fin n) (P : SimpleGraph.QuarterFloor.Pent M.graph h),
  M.Triangulated → (∀ (v : Fin n), ∃ w, M.graph.Adj v w) → SimpleGraph.QuarterFloor.ChainFormulaF M P
@[expose] def SimpleGraph.VacancyShortFill.Whole.{u_1, u_2} : {V : Type u_1} →
  {C : Type u_2} → SimpleGraph V → V → (V → C) → C → C → Set V → Prop :=
fun {V} {C} G h c a b S =>
  ∃ s,
    SimpleGraph.VacancyShortFill.Active h c a b s ∧
      ∀ (v : V), v ∈ S ↔ (SimpleGraph.VacancyShortFill.pairGraph G h c a b).Reachable s v
@[expose] def SimpleGraph.QuarterFloor.StarHyp.{u_1} : {V : Type u_1} →
  {G : SimpleGraph V} → Equiv.Perm G.Dart → {h : V} → SimpleGraph.QuarterFloor.Pent G h → Prop :=
fun {V} {G} φ {h} P =>
  ∀ (i : Fin 5),
    (φ { fst := h, snd := P.x i, adj := ⋯ }).toProd.2 = P.x (i + 1) ∨
      (φ { fst := h, snd := P.x i, adj := ⋯ }).toProd.2 = P.x (i + 4)
@SimpleGraph.QuarterFloor.lemmaW : ∀ {V : Type u_1} [inst : Fintype V] [DecidableEq V] {G : SimpleGraph V}
  [inst_2 : DecidableRel G.Adj] (φ : Equiv.Perm G.Dart),
  (∀ (d : G.Dart), (φ d).toProd.1 = d.toProd.2) →
    (∀ (d : G.Dart), φ (φ (φ d)) = d) →
      ∀ {h : V} {c : V → Fin 4} {p q : Fin 4} {X : Set V} (P : SimpleGraph.QuarterFloor.Pent G h),
        SimpleGraph.QuarterFloor.StarHyp φ P →
          SimpleGraph.VacancySlide.ProperOff G h c →
            p ≠ q →
              SimpleGraph.VacancyShortFill.Whole G h c p q X →
                SimpleGraph.QuarterFloor.LinkBalanced P c p q X →
                  ↑(SimpleGraph.QuarterFloor.cwCount φ h (SimpleGraph.VacancyShortFill.swap c p q X)) =
                    ↑(SimpleGraph.QuarterFloor.cwCount φ h c) + 2 * ↑(SimpleGraph.QuarterFloor.linkInner P X)
@SimpleGraph.QuarterFloor.lemmaW_linkFree : ∀ {V : Type u_1} [inst : Fintype V] [DecidableEq V] {G : SimpleGraph V}
  [inst_2 : DecidableRel G.Adj] (φ : Equiv.Perm G.Dart),
  (∀ (d : G.Dart), (φ d).toProd.1 = d.toProd.2) →
    (∀ (d : G.Dart), φ (φ (φ d)) = d) →
      ∀ {h : V} {c : V → Fin 4} {p q : Fin 4} {X : Set V} (P : SimpleGraph.QuarterFloor.Pent G h),
        SimpleGraph.QuarterFloor.StarHyp φ P →
          SimpleGraph.VacancySlide.ProperOff G h c →
            p ≠ q →
              SimpleGraph.VacancyShortFill.Whole G h c p q X →
                (∀ (i : Fin 5), P.x i ∉ X) →
                  ↑(SimpleGraph.QuarterFloor.cwCount φ h (SimpleGraph.VacancyShortFill.swap c p q X)) =
                    ↑(SimpleGraph.QuarterFloor.cwCount φ h c)
@SimpleGraph.QuarterFloor.cw_piMove : ∀ {n : ℕ} {M : SimpleGraph.SphericalMap n} {h : Fin n} {c : Fin n → Fin 4}
  {j : Fin 5},
  M.Triangulated →
    ∀ (P : SimpleGraph.QuarterFloor.Pent M.graph h),
      SimpleGraph.VacancySlide.ProperOff M.graph h c →
        SimpleGraph.QuarterFloor.DoublyLocked P c j →
          ↑(SimpleGraph.QuarterFloor.cwCount M.rotation.faceNext h (SimpleGraph.QuarterFloor.piMove P c)) =
            ↑(SimpleGraph.QuarterFloor.cwCount M.rotation.faceNext h c) + 2

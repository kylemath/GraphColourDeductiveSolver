'SimpleGraph.QuarterFloor.chainCount_comm' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.chainCount_swap_same' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.chainCount_swap_other' depends on axioms: [propext, Classical.choice, Quot.sound]
'SimpleGraph.QuarterFloor.sum_pairs_roles' depends on axioms: [propext, Classical.choice, Quot.sound]

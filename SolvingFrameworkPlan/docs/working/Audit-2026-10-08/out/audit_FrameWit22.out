@[expose] def SimpleGraph.SphericalMap.RStarFrame : Prop :=
∀ (m : ℕ) (T : SimpleGraph.SphericalMap m),
  0 < m →
    T.graph.Connected →
      T.Triangulated →
        (∀ (x : Fin m), 5 ≤ T.graph.degree x) →
          T.NoSep → T.DiamondFree → T.Conf2122Free → ∃ v, T.graph.degree v = 5 ∧ T.PureClean v

   RowBox[{"{", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"V", "[", "x__", "]"}], "m_"], "\[RuleDelayed]", 
     RowBox[{"V", "[", "x", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"len", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"Caps3", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "len"}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Caps3", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "i"}], "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", 
             RowBox[{
              RowBox[{"Caps3", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "j"}], "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&&", 
            RowBox[{
             RowBox[{
              RowBox[{"Caps3", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "j"}], "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", 
             RowBox[{
              RowBox[{"Caps3", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "i"}], "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "&&", 
            RowBox[{
             RowBox[{
              RowBox[{"Caps3", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "i"}], "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "<", 
             RowBox[{
              RowBox[{"Caps3", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "j"}], "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"Caps3", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "*=", 
            RowBox[{"V", "[", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Caps3", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "i"}], "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"Caps3", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "i"}], "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"Min", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Caps3", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "j"}], "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"Caps3", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "j"}], "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i", ",", "len"}], "}"}]}], "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "130"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Caps", "=", 
   RowBox[{
    RowBox[{"Caps3", "//.", "RemoveExp"}], "//.", "SimplificationRule"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.921678782486205*^9, 3.921678797829175*^9}, {

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"arc", ",", "Orderless"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"V", ",", "Orderless"}], "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "following", " ", "rule", " ", "eliminates", " ", "any", " ", 
     "cap", " ", "with", " ", "a", " ", "loop", " ", "at", " ", "one", " ", 
     "of", " ", "the", " ", "perfect", " ", "matching", " ", "edges"}], ",", 
    " ", 
    RowBox[{
    "since", " ", "such", " ", "a", " ", "cap", " ", "will", " ", "never", 
     " ", "be", " ", 
     RowBox[{"colorable", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"SimplifyCaps", ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", "a_"}], "}"}], ",", "b_", ",", "c_", ",", "d_", 
       ",", "e_", ",", "f_"}], "}"}], "\[RuleDelayed]", "0"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b_", ",", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "a_"}], "}"}], ",", "c_", ",", "d_", ",", "e_", 
       ",", "f_"}], "}"}], "\[RuleDelayed]", "0"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b_", ",", "c_", ",", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "a_"}], "}"}], ",", "d_", ",", "e_", ",", "f_"}], 
      "}"}], "\[RuleDelayed]", "0"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b_", ",", "c_", ",", "d_", ",", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "a_"}], "}"}], ",", "e_", ",", "f_"}], "}"}], 
     "\[RuleDelayed]", "0"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b_", ",", "c_", ",", "d_", ",", "e_", ",", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "a_"}], "}"}], ",", "f_"}], "}"}], 
     "\[RuleDelayed]", "0"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b_", ",", "c_", ",", "d_", ",", "e_", ",", "f_", ",", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "a_"}], "}"}]}], "}"}], "\[RuleDelayed]", "0"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"ToArcRule", ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a_", ",", "b_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"c_", ",", "d_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"e_", ",", "f_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"g_", ",", "h_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i_", ",", "j_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k_", ",", "l_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"arc", "[", 
       RowBox[{"a", ",", "b"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"c", ",", "d"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"e", ",", "f"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"g", ",", "h"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"i", ",", "j"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"k", ",", "l"}], "]"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Perms", "=", 
   RowBox[{"Permutations", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"temp", ",", 
       RowBox[{"{", "}"}]}], "]"}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{
         RowBox[{"temp", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{
            RowBox[{"Perms", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "6"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "Perms", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PreCaps", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"temp", "//.", "SimplifyCaps"}], "/.", "ToArcRule"}], "//", 
       "DeleteDuplicates"}], ",", "0"}], "]"}], "]"}]}], ";"}]}], "Input",

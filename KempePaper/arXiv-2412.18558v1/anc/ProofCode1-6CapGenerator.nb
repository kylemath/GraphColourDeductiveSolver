Cell[CellGroupData[{

Cell["Adding interaction sites between arcs", "Section",
 CellChangeTimes->{{3.932823940776684*^9, 
  3.932823952478187*^9}},ExpressionUUID->"7df79f80-6e66-4352-aeaa-\
899448c25a48"],

Cell["\<\
At  this  point, Caps is a list of 130 basic caps which contain a minimal set \
of interactions necessary for the cap to exist in a state for a planar graph. \
 In general, other interactions may show up in the cap portion of a given \
state graph. Here, we account for these possibilities.  The strategy is \
simple:  
1) Number the cap arcs 1 through 6 by the order in which they appear in the \
basic cap.  
2) Enumerate the possible interactions between arcs.
3) For each of the 130 basic caps, multiply by each of the possible sets of \
interactions (i.e. a list of interactions denoted by terms of the form \
V[a,b]).  
4) Zero out any such products that result in an interaction between two arcs \
that meet at a spoke.
Finally we delete duplicates, and zeros to obtain a list of caps.  \
\>", "Text",
 CellChangeTimes->{{3.933081615531607*^9, 3.933081664625369*^9}, {
  3.933081741604426*^9, 3.933081873691435*^9}, {3.93308196605724*^9, 
  3.933082140307191*^9}, {3.933082197569083*^9, 3.933082199940827*^9}, {
  3.933669834807481*^9, 3.93366984326895*^9}, {3.943369096253788*^9, 
  3.943369135076516*^9}, {3.9433691651688023`*^9, 3.943369190139763*^9}, {
  3.943697793287761*^9, 
  3.9436978267519097`*^9}},ExpressionUUID->"7695ed62-003e-48ab-a108-\
11f0b950c433"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ArcInteractions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "6"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ArcInteractionCases", "=", 
   RowBox[{"Subsets", "[", "ArcInteractions", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ArcInteractionCases", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"{", "1", "}"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AddInteractions", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cap", "=", "x"}], ",", 
       RowBox[{"virt", "=", "y"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"virt", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "!=", 
         RowBox[{"{", "1", "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"cap", "*=", 
            RowBox[{"V", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cap", "[", 
                RowBox[{"[", 
                 RowBox[{"virt", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"cap", "[", 
                RowBox[{"[", 
                 RowBox[{"virt", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", 
             RowBox[{"Length", "[", "virt", "]"}]}], "}"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "cap"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SimplificationRule1", ":=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"arc", "[", 
       RowBox[{"a_", ",", "b_"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"c_", ",", "d_"}], "]"}], 
      RowBox[{"V", "[", 
       RowBox[{"a_", ",", "c_"}], "]"}]}], "\[RuleDelayed]", 
     RowBox[{"0", "/;", 
      RowBox[{
       RowBox[{"OddQ", "[", "a", "]"}], "&&", 
       RowBox[{"c", "\[Equal]", 
        RowBox[{"a", "+", "1"}]}], "&&", 
       RowBox[{"a", "<", "b"}], "&&", 
       RowBox[{"c", "<", "d"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"arc", "[", 
       RowBox[{"a_", ",", "b_"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"c_", ",", "d_"}], "]"}], 
      RowBox[{"V", "[", 
       RowBox[{"a_", ",", "d_"}], "]"}]}], "\[RuleDelayed]", 
     RowBox[{"0", "/;", 
      RowBox[{
       RowBox[{"OddQ", "[", "a", "]"}], "&&", 
       RowBox[{"c", "\[Equal]", 
        RowBox[{"a", "+", "1"}]}], "&&", 
       RowBox[{"a", "<", "b"}], "&&", 
       RowBox[{"d", "<", "c"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"arc", "[", 
       RowBox[{"a_", ",", "b_"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"c_", ",", "d_"}], "]"}], 
      RowBox[{"V", "[", 
       RowBox[{"b_", ",", "c_"}], "]"}]}], "\[RuleDelayed]", 
     RowBox[{"0", "/;", 
      RowBox[{
       RowBox[{"OddQ", "[", "a", "]"}], "&&", 
       RowBox[{"c", "\[Equal]", 
        RowBox[{"a", "+", "1"}]}], "&&", 
       RowBox[{"b", "<", "a"}], "&&", 
       RowBox[{"c", "<", "d"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"arc", "[", 
       RowBox[{"a_", ",", "b_"}], "]"}], 
      RowBox[{"arc", "[", 
       RowBox[{"c_", ",", "d_"}], "]"}], 
      RowBox[{"V", "[", 
       RowBox[{"b_", ",", "d_"}], "]"}]}], "\[RuleDelayed]", 
     RowBox[{"0", "/;", 
      RowBox[{
       RowBox[{"OddQ", "[", "a", "]"}], "&&", 
       RowBox[{"c", "\[Equal]", 
        RowBox[{"a", "+", "1"}]}], "&&", 
       RowBox[{"b", "<", "a"}], "&&", 
       RowBox[{"d", "<", "c"}]}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SixCaps1", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"AddInteractions", "[", 
          RowBox[{
           RowBox[{"Caps", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"ArcInteractionCases", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "//.", 
         "SimplificationRule1"}], "//.", "RemoveExp"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "Caps", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "ArcInteractionCases", "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SixCaps", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"SixCaps1", ",", "1"}], "]"}], "//", "DeleteDuplicates"}], ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "0"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.928316192991948*^9, 3.928316204683745*^9}, {
   3.928327942061452*^9, 3.928327976472582*^9}, {3.928328023543745*^9, 
   3.928328084517391*^9}, 3.928328127119813*^9, {3.928328214824729*^9, 
   3.928328216934275*^9}, {3.928328327082567*^9, 3.928328334206288*^9}, {
   3.928328571339541*^9, 3.928328572956748*^9}, {3.928328639564582*^9, 
   3.928328681149325*^9}, {3.928328720299761*^9, 3.928328728132476*^9}, {
   3.933082936906919*^9, 3.933082942403257*^9}},
 CellLabel->
  "In[245]:=",ExpressionUUID->"74f05bf2-f0a2-474e-a53a-64896f8e9b3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SixCaps", "//", "Length"}]], "Input",
 CellChangeTimes->{{3.9434468646251507`*^9, 3.943446867337678*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"787268d5-310b-40f6-ae46-513eb12a6916"],

Cell[BoxData["43707"], "Output",
 CellChangeTimes->{3.943447162677462*^9, 3.943523780290732*^9},

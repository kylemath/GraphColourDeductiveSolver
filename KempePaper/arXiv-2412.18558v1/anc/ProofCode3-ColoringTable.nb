Cell[TextData[{
 "\nThe next command is the check of state - extendible for each state graph \
. For each entry we take the colored cap, remove the interactions \
(killVirtuals), multiply it by the coloring of the capped state and then use ",
 StyleBox["checkCapMatch",
  FontSlant->"Italic"],
 " to reduce the result . The rule, ",
 StyleBox["checkCapMatch",
  FontSlant->"Italic"],
 ", looks for pairs of cap arcs (involving exactly 2 arc labels) with other \
arcs (from the capped state) and checks two things: 1) that the cap arc is \
contained in a single capped state arc and 2) that the the capped state arc \
is colored appropriately. If both of those conditions are satisfied the cap \
arc is removed . The table entry is a value of true or false to indicate \
whether the result of this check is equal to the coloring of the capped state \
we started with."
}], "Text",
 CellChangeTimes->{{3.944046698938321*^9, 3.944046721830365*^9}, {
   3.94404680187646*^9, 3.944046908271091*^9}, 
   3.9440470941741133`*^9},ExpressionUUID->"e2d525ae-5b07-4474-a296-\
3dc1b86c8e4d"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FPResults", "[", 
     RowBox[{"[", 
      RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ColoredCaps", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], "//.", 
         "killVirtuals"}], ")"}], " ", 
       RowBox[{"FPResults", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", " ", "j"}], "]"}], "]"}]}], " ", "//.", " ", 
      "checkCapMatch"}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", "FPResults", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "1", ",", 
     RowBox[{"Length", "[", 
      RowBox[{"FPResults", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]], "Input",

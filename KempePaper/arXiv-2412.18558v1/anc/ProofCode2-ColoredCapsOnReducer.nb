       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"ColoredCaps", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "ColoredCaps", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "This", " ", "loop", " ", "takes", " ", "a", " ", "colored", " ", "cap", 
      " ", "and", " ", "attempts", " ", "to", " ", "plub", " ", "in", " ", 
      "states", " ", "of", " ", "the", " ", "Birkhoff", " ", "reducer"}], ",",
      " ", 
     RowBox[{
     "and", " ", "extend", " ", "the", " ", "coloring", " ", "onto", " ", 
      "the", " ", 
      RowBox[{"state", ".", "  ", "If"}], " ", "it", " ", "can"}], ",", " ", 
     RowBox[{
     "the", " ", "coloring", " ", "is", " ", "stored", " ", "in", " ", "the", 

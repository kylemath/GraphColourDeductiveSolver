      "1."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ParallelDo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"foundOne", "=", "False"}], ";", "\[IndentingNewLine]", 
          RowBox[{"testdata", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"ColoredCaps", "[", 
              RowBox[{"[", 

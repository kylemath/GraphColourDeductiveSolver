            "//.", "pushColorsIn"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"foundOne", "=", "False"}], ";", "\[IndentingNewLine]", 
              
              RowBox[{"possibleColoring", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"testdata", "[", 

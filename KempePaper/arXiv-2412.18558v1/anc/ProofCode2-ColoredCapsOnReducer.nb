Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"A", ",", "Orderless"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"V", ",", "Orderless"}], "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Changes", " ", "the", " ", "color", " ", "of", " ", "an", " ", "arc", " ",
     "as", " ", "indicated"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colorArc", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"arc", "[", 
        RowBox[{"c_", ",", 
         RowBox[{"A", "[", "x__", "]"}]}], "]"}], ":>", 
       RowBox[{"arc", "[", 
        RowBox[{"1", ",", 
         RowBox[{"A", "[", "x", "]"}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"arc", "[", 
        RowBox[{"c_", ",", 
         RowBox[{"A", "[", "x__", "]"}]}], "]"}], ":>", 
       RowBox[{"arc", "[", 
        RowBox[{"2", ",", 
         RowBox[{"A", "[", "x", "]"}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"arc", "[", 
        RowBox[{"c_", ",", 
         RowBox[{"A", "[", "x__", "]"}]}], "]"}], ":>", 
       RowBox[{"arc", "[", 
        RowBox[{"3", ",", 
         RowBox[{"A", "[", "x", "]"}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"arc", "[", 
        RowBox[{"c_", ",", 
         RowBox[{"A", "[", "x__", "]"}]}], "]"}], ":>", 
       RowBox[{"arc", "[", 
        RowBox[{"4", ",", 
         RowBox[{"A", "[", "x", "]"}]}], "]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Reformats", " ", "the", " ", "arcs", " ", "to", " ", "include", " ", 
    "coloring", " ", "information"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fixCaps", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"arc", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"arc", "[", 
        RowBox[{"0", ",", 
         RowBox[{"A", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "]"}], "/;", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "y", "]"}], "==", "Integer"}], "&&", 
        RowBox[{
         RowBox[{"Head", "[", "x", "]"}], "==", "Integer"}]}]}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Checks", " ", "for", " ", "a", " ", "valid", " ", "coloring", " ", "in", 
     " ", "the", " ", "cap"}], ",", " ", 
    RowBox[{"including", " ", "the", " ", "spokes"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checkColor", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"arc", "[", 
         RowBox[{"c1_", ",", 
          RowBox[{"A", "[", "x__", "]"}]}], "]"}], 
        RowBox[{"arc", "[", 
         RowBox[{"c2_", ",", 
          RowBox[{"A", "[", "y__", "]"}]}], "]"}], 
        RowBox[{"V", "[", 
         RowBox[{"a_", ",", "b_"}], "]"}]}], ":>", 
       RowBox[{"0", "/;", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"List", "[", "x", "]"}], ",", "a"}], "]"}], "&&", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"List", "[", "y", "]"}], ",", "b"}], "]"}], "&&", 
         RowBox[{"c1", "==", "c2"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"arc", "[", 
         RowBox[{"c_", ",", 
          RowBox[{"A", "[", "x__", "]"}]}], "]"}], 
        RowBox[{"arc", "[", 
         RowBox[{"c_", ",", 
          RowBox[{"A", "[", "y__", "]"}]}], "]"}]}], ":>", 
       RowBox[{"0", "/;", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "first", " ", "three", " ", "commands", " ", "build", " ", 
    "the", " ", "state", " ", "system", " ", "for", " ", "the", " ", 
    "Birkhoff", " ", "reducer"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Reducer", "=", 
     RowBox[{
      RowBox[{"M", "[", 
       RowBox[{"2", ",", "1", ",", "12", ",", "11"}], "]"}], 
      RowBox[{"M", "[", 
       RowBox[{"4", ",", "3", ",", "14", ",", "13"}], "]"}], 
      RowBox[{"M", "[", 
       RowBox[{"6", ",", "5", ",", "13", ",", "15"}], "]"}], 
      RowBox[{"M", "[", 
       RowBox[{"8", ",", "7", ",", "16", ",", "18"}], "]"}], 
      RowBox[{"M", "[", 
       RowBox[{"10", ",", "9", ",", "18", ",", "17"}], "]"}], 
      RowBox[{"M", "[", 
       RowBox[{"15", ",", "14", ",", "17", ",", "16"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReducerStates", "=", 
     RowBox[{"MonomialList", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Reducer", "//.", "expandMatchings"}], ")"}], "//", 
       "Expand"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReducerStates", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"ReducerStates", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "//.", "RemoveExp"}], "//.", 
            "mergeColoredArcs"}], "//.", "fixV"}], "//.", 
          "zeroImproperColors"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "ReducerStates", "]"}]}], "}"}]}], "]"}], 
       ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Prepare", " ", "a", " ", "list", " ", "for", " ", "storing", " ", 
      "colored", " ", "caps", " ", "that", " ", "are", " ", "compatible", " ",
       "with", " ", "the", " ", "Birkhoff", " ", 
      RowBox[{"reducer", ".", "  ", "A"}], " ", "value", " ", "of"}], " ", 
     "-", 
     RowBox[{
     "1", " ", "indicates", " ", "that", " ", "the", " ", "colored", " ", 
      "cap", " ", "is", " ", "not", " ", "compatible", " ", "with", " ", 
      "the", " ", 
      RowBox[{"reducer", ".", "  ", "This"}], " ", "value", " ", "is", " ", 
      "overwritten", " ", "when", " ", "a", " ", "coloring", " ", "of", " ", 
      "a", " ", "capped", " ", "state", " ", "is", " ", 
      RowBox[{"found", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetSharedVariable", "[", "results", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"Table", "[", 

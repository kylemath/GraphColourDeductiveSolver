              RowBox[{"k", ",", "1", ",", 
               RowBox[{"Length", "[", "testdata", "]"}]}], "}"}]}], "]"}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"foundOne", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"results", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "m"}], "]"}], "]"}], "=", 
               RowBox[{"ColoredCaps", "[", 
                RowBox[{"[", 
                 RowBox[{"n", ",", "m"}], "]"}], "]"}]}], ";", " ", 
              RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}]}], ";"}], 

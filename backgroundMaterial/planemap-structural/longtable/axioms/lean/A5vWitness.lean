module

public import A5vJordan
public import A5vWitnessMap

/-!
# Non-vacuity of the A5v statements

`A5vWitnessMap` is the Tait dual of an 8-vertex sphere triangulation `T` with a degree-5 hole
`h` (generated by `gen_smap_faces.py`, `Fills` proved by a linear certificate): 8 vertices,
13 edges, 7 faces, the vertex `0` of degree 5 (the hole's pentagon) and the others cubic.
The primal `T` (oriented faces) and the dual face list are recorded in `witness.json`.

At the perfect matching `{04, 15, 27, 36}` (frame `k = 4`, spokes `f = (1, 5, 6, 3, 4)` in
rotation order at `0`), `E − Mt` is the figure-eight `X = 0‑1‑2‑4‑3‑0` (through
`f 0 = f (k+1)` and `f 3 = f (k−1)`, four vertices besides `0`) and `Y = 0‑5‑7‑6‑0` (through
`f 1 = f (k+2)` and `f 2 = f (k−2)`, three vertices). This is a DL-good state in TrackU's
sense. Here every hypothesis of `a5v` and `a5v_parity` is proved by finite checks, so neither
theorem is vacuous. The partner of `0` is `4 ∈ X`, and `Mt ∩ E(X, Y) = {15, 27, 36}`.
-/

@[expose] public section
namespace SimpleGraph.A5vWit
open SimpleGraph.A5v

/-- The spokes at the hole vertex `0`, in rotation order. -/
def fsT : Fin 5 → Fin 8 := ![1, 5, 6, 3, 4]

theorem fs_adj (i : Fin 5) : graph.Adj 0 (fsT i) := by
  have h : ∀ i : Fin 5, adjB 0 (fsT i) = true := by decide
  exact (adj_iff 0 (fsT i)).mpr (h i)

/-- The degree-5 vertex `0` with its spokes. -/
def hole : Hole5 sphericalMap.rotation where
  v := 0
  f i := ⟨(0, fsT i), fs_adj i⟩
  fst_f _ := rfl
  next_f i := by
    have h : ∀ i : Fin 5, nextTable 0 (fsT i) = fsT (i + 1) := by decide
    exact Dart.ext _ _ (Prod.ext rfl (h i))
  inj := by
    intro i j hij
    have h : ∀ i j : Fin 5, fsT i = fsT j → i = j := by decide
    exact h i j (congrArg (fun d : graph.Dart => d.snd) hij)

/-- The matching `{04, 15, 27, 36}` as a partner table. -/
def partnerT : Fin 8 → Fin 8 := ![4, 5, 7, 6, 0, 1, 3, 2]

/-- The state: a perfect matching. -/
def Mt : SimpleGraph (Fin 8) where
  Adj a b := partnerT a = b
  symm := ⟨fun a b h => by
    have hh : ∀ a : Fin 8, partnerT (partnerT a) = a := by decide
    rw [← h]; exact hh a⟩
  loopless := ⟨fun a h => by
    have hh : ∀ a : Fin 8, partnerT a ≠ a := by decide
    exact hh a h⟩

theorem pm : IsPerfectMatching sphericalMap.graph Mt where
  le := by
    intro a b h
    have h' : partnerT a = b := h
    subst h'
    have hh : ∀ a : Fin 8, adjB a (partnerT a) = true := by decide
    exact (adj_iff _ _).mpr (hh a)
  unique u := ⟨partnerT u, rfl, fun _ h => Eq.symm h⟩

theorem cubic : CubicOff hole := by
  intro u hu
  rw [sphericalMap_degree]
  revert u
  decide

/-- `E − Mt` with `0` deleted. -/
abbrev Q : SimpleGraph (Fin 8) := qGraph sphericalMap.graph Mt 0

theorem qadj {a b : Fin 8} (h : adjB a b = true ∧ partnerT a ≠ b ∧ a ≠ 0 ∧ b ≠ 0) : Q.Adj a b :=
  ⟨(adj_iff a b).mpr h.1, h.2.1, h.2.2.1, h.2.2.2⟩

/-- A vertex labelling constant along `Q`-edges is constant on `Q`-components. -/
theorem reach_label (l : Fin 8 → Bool)
    (hl : ∀ a b, adjB a b = true → partnerT a ≠ b → a ≠ 0 → b ≠ 0 → l a = l b)
    {a b : Fin 8} (h : Q.Reachable a b) : l a = l b := by
  obtain ⟨p⟩ := h
  induction p with
  | nil => rfl
  | cons e _ ih => exact (hl _ _ ((adj_iff _ _).mp e.1) e.2.1 e.2.2.1 e.2.2.2).trans ih

/-- The `X`-side labelling. -/
def lx : Fin 8 → Bool := ![false, true, true, true, true, false, false, false]

theorem hlx : ∀ a b, adjB a b = true → partnerT a ≠ b → a ≠ 0 → b ≠ 0 → lx a = lx b := by
  decide

theorem r12 : Q.Reachable 1 2 := (qadj (by decide)).reachable
theorem r14 : Q.Reachable 1 4 := r12.trans (qadj (by decide)).reachable
theorem r13 : Q.Reachable 1 3 := r14.trans (qadj (by decide)).reachable
theorem r57 : Q.Reachable 5 7 := (qadj (by decide)).reachable
theorem r56 : Q.Reachable 5 6 := r57.trans (qadj (by decide)).reachable

theorem fig8 : Fig8 hole Mt 4 where
  mk_adj := rfl
  pairX := r13
  pairY := r56
  sepXY := fun h => absurd (reach_label lx hlx h) (by decide)
  cover := by
    intro u hu
    fin_cases u
    · exact absurd rfl hu
    · exact Or.inl (Reachable.refl _)
    · exact Or.inl r12
    · exact Or.inl r13
    · exact Or.inl r14
    · exact Or.inr (Reachable.refl _)
    · exact Or.inr r56
    · exact Or.inr r57

theorem inX_iff (u : Fin 8) : InX hole Mt 4 u ↔ lx u = true := by
  constructor
  · intro h
    rw [← reach_label lx hlx h]
    rfl
  · intro h
    fin_cases u
    · exact absurd h (by decide)
    · exact Reachable.refl _
    · exact r12
    · exact r13
    · exact r14
    · exact absurd h (by decide)
    · exact absurd h (by decide)
    · exact absurd h (by decide)

theorem xVerts_eq : xVerts hole Mt 4 = {1, 2, 3, 4} := by
  ext u
  simp only [xVerts, Finset.mem_filter, Finset.mem_univ, true_and, inX_iff]
  revert u
  decide

theorem xeven : XEven hole Mt 4 := by
  unfold XEven
  rw [xVerts_eq]
  decide

/-- **Non-vacuity of `a5v`**: all its hypotheses hold here. -/
theorem witness_a5v : A5vAt hole Mt 4 := a5v hole pm cubic fig8

/-- **Non-vacuity of `a5v_parity`**: all its hypotheses hold here. -/
theorem witness_parity : Odd (crossXY hole Mt 4) := a5v_parity hole pm cubic fig8 xeven

/-- Direct check: the partner `4` of the hole vertex is an `X`-vertex. -/
theorem witness_a5v_direct : A5vAt hole Mt 4 := (inX_iff 4).mpr rfl

end SimpleGraph.A5vWit

#print axioms SimpleGraph.A5vWit.witness_a5v
#print axioms SimpleGraph.A5vWit.witness_parity
#print axioms SimpleGraph.A5vWit.witness_a5v_direct

module

public import A5vBridge
public import A5vPrimMap

/-!
# Non-vacuity of the primal A5v bridge

`A5vPrimMap` is an 8-vertex sphere triangulation `T` (generated by Studio Math's `gen_smap.py`
from the faces in `scripts/primal_witness.json`, found by `scripts/primal_dl.py`). The vertex `3` has degree 5,
with link `x = (0, 5, 4, 1, 2)` in rotation order. The colouring
`(0, 1, 2, –, 2, 3, 1, 2)` is proper off `3` and doubly locked at `j = 2`: link colours
`(α, μ, α, A, B) = (2, 1, 2, 0, 3)` at `x 2, …, x 1`. The chains are `K = {2, 0, 7}`,
`K' = {4}` and `L = {1, 5, 6}`, so `ThreeChains` holds. The far triangle of the matching
spoke `x 4 x 0 = 2 0` is `{2, 0, 1}`. All hypotheses of `a5v_primal` and `triangle_step` hold
here.
-/

@[expose] public section
namespace SimpleGraph.A5vPrim
open QuarterFloor VacancySlide VacancyShortFill A5vBridge

/-- The link of the hole `3`, in rotation order. -/
def xT : Fin 5 → Fin 8 := ![0, 5, 4, 1, 2]

def pent : Pent sphericalMap.graph 3 where
  x := xT
  adj_h i := by
    have h : ∀ i : Fin 5, adjB 3 (xT i) = true := by decide
    exact (adj_iff _ _).mpr (h i)
  adj_cyc i := by
    have h : ∀ i : Fin 5, adjB (xT i) (xT (i + 1)) = true := by decide
    exact (adj_iff _ _).mpr (h i)
  inj := by
    intro i j hij
    have h : ∀ i j : Fin 5, xT i = xT j → i = j := by decide
    exact h i j hij
  only v hv := by
    have h : ∀ v : Fin 8, adjB 3 v = true → ∃ i, v = xT i := by decide
    exact h v ((adj_iff _ _).mp hv)

/-- The colouring (the value at the hole `3` is irrelevant). -/
def col : Fin 8 → Fin 4 := ![0, 1, 2, 0, 2, 3, 1, 2]

theorem proper : ProperOff sphericalMap.graph 3 col := by
  intro u v e hu hv
  have h : ∀ u v : Fin 8, adjB u v = true → u ≠ 3 → v ≠ 3 → col u ≠ col v := by decide
  exact h u v ((adj_iff _ _).mp e) hu hv

theorem pair_adj {a b : Fin 4} {u v : Fin 8}
    (h : adjB u v = true ∧ u ≠ 3 ∧ v ≠ 3 ∧ (col u = a ∨ col u = b) ∧ (col v = a ∨ col v = b)) :
    (pairGraph sphericalMap.graph 3 col a b).Adj u v :=
  ⟨(adj_iff _ _).mpr h.1, ⟨h.2.1, h.2.2.2.1⟩, ⟨h.2.2.1, h.2.2.2.2⟩⟩

theorem dl : DoublyLocked pent col 2 :=
  ⟨by unfold RepeatAt; decide, (pair_adj (by decide)).reachable,
    (pair_adj (by decide)).reachable⟩

theorem k0 : InK pent col 2 0 := (pair_adj (by decide)).reachable
theorem k7 : InK pent col 2 7 := k0.trans (pair_adj (by decide)).reachable
theorem l5 : InL pent col 2 5 := (pair_adj (by decide)).reachable
theorem l6 : InL pent col 2 6 := l5.trans (pair_adj (by decide)).reachable

theorem three : ThreeChains pent col 2 := by
  intro u hu
  fin_cases u
  · exact ⟨fun _ => Or.inl k0, fun h => absurd h (by decide)⟩
  · exact ⟨fun h => absurd h (by decide), fun _ => Reachable.refl _⟩
  · exact ⟨fun _ => Or.inl (Reachable.refl _), fun h => absurd h (by decide)⟩
  · exact absurd rfl hu
  · exact ⟨fun _ => Or.inr (Reachable.refl _), fun h => absurd h (by decide)⟩
  · exact ⟨fun h => absurd h (by decide), fun _ => l5⟩
  · exact ⟨fun h => absurd h (by decide), fun _ => l6⟩
  · exact ⟨fun _ => Or.inl k7, fun h => absurd h (by decide)⟩

theorem e2 : sphericalMap.graph.Adj (pent.x (2 + 2)) 1 := (adj_iff _ _).mpr (by decide)
theorem e3 : sphericalMap.graph.Adj (pent.x (2 + 3)) 1 := (adj_iff _ _).mpr (by decide)

/-- **Non-vacuity of `a5v_primal`**: the far triangle `{2, 0, 1}` of the matching spoke has
both non-matching edges on `X` and none on `Y`. -/
theorem witness_a5v_primal :
    (tX pent col 2 (pent.x (2 + 2)) 1 ∧ tX pent col 2 (pent.x (2 + 3)) 1) ∧
      (¬ tY pent col 2 (pent.x (2 + 2)) 1 ∧ ¬ tY pent col 2 (pent.x (2 + 3)) 1) :=
  a5v_primal proper dl three (by decide) e2 e3

/-- `¬inA` here, from the formal D2. -/
theorem witness_notInA : ¬ InA pent col 2 := notInA dl.1 dl.2.2

/-- The `X`-spoke `x 3 x 4 = 1 2` as a dart. -/
def dX : sphericalMap.Dart := ⟨(1, 2), (adj_iff _ _).mpr (by decide)⟩

/-- **Non-vacuity of `triangle_step`** at the dart `1 → 2` (its triangle is `{1, 2, 0}`). -/
theorem witness_triangle_step :
    (tX pent col 2 dX.snd (sphericalMap.rotation.faceNext dX).snd ∧
        tM pent col 2 (sphericalMap.rotation.faceNext dX).snd dX.fst) ∨
      (tM pent col 2 dX.snd (sphericalMap.rotation.faceNext dX).snd ∧
        tX pent col 2 (sphericalMap.rotation.faceNext dX).snd dX.fst) :=
  triangle_step proper dl.1 sphericalMap_triangulated dX
    ⟨dX.adj, Or.inr ⟨Reachable.refl _, Reachable.refl _⟩⟩ (by decide)

end SimpleGraph.A5vPrim

#print axioms SimpleGraph.A5vPrim.witness_a5v_primal
#print axioms SimpleGraph.A5vPrim.witness_notInA
#print axioms SimpleGraph.A5vPrim.witness_triangle_step

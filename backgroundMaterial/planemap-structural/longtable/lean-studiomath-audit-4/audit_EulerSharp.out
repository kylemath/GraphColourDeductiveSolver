@SimpleGraph.SphericalMap.twelve_light_fives : ∀ {n : ℕ} (M : SimpleGraph.SphericalMap n) (d : M.Dart),
  (∀ (f : M.Face), M.rotation.faceLength f = 3) →
    (∀ (v : Fin n), 5 ≤ M.graph.degree v) → 12 ≤ (StudioMath.goodSet M.graph).card
@SimpleGraph.SphericalMap.edge_card_bound_sharp : ∀ {n : ℕ} (M : SimpleGraph.SphericalMap n) (d : M.Dart),
  Fintype.card ↑M.graph.edgeSet + 2 ≤ n + Fintype.card M.Face
SimpleGraph.Icosahedron.twelve_light_fives_icosahedron : 12 ≤
  (StudioMath.goodSet SimpleGraph.Icosahedron.sphericalMap.graph).card
@SimpleGraph.SphericalMap.relative_light_fives : ∀ {n : ℕ} (M : SimpleGraph.SphericalMap n) (d : M.Dart),
  (∀ (f : M.Face), M.rotation.faceLength f = 3) →
    ∀ (φ : Finset (Fin n)),
      φ.card ≤ 3 →
        (∀ (v : Fin n), 5 ≤ M.graph.degree v ∨ v ∈ φ ∧ M.graph.degree v = 4) →
          9 ≤ {x ∈ StudioMath.goodSet M.graph | x ∉ φ}.card + {v ∈ φ | M.graph.degree v = 4}.card
SimpleGraph.Icosahedron.relative_light_fives_icosahedron : 9 ≤
  {x ∈ StudioMath.goodSet SimpleGraph.Icosahedron.sphericalMap.graph | x ∉ {0, 1, 5}}.card +
    {v ∈ {0, 1, 5} | SimpleGraph.Icosahedron.sphericalMap.graph.degree v = 4}.card
@[expose] def StudioMath.goodSet.{u_1} : {V : Type u_1} →
  [Fintype V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → Finset V :=
fun {V} [Fintype V] G [DecidableRel G.Adj] =>
  {v | G.degree v = 5 ∧ (Finset.filter (G.Adj v) (StudioMath.highSet G)).card ≤ 1}
@[expose] def StudioMath.highSet.{u_1} : {V : Type u_1} →
  [Fintype V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → Finset V :=
fun {V} [Fintype V] G [DecidableRel G.Adj] => {v | 12 ≤ G.degree v}

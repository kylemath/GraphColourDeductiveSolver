@[expose] def SimpleGraph.SphericalMap.RStarSupport : Prop :=
∀ (m : ℕ) (T : SimpleGraph.SphericalMap m) (p q r : Fin m), T.RelClass p q r → T.NoSep → T.CleanOff p q r
@[expose] def SimpleGraph.SphericalMap.PureClean : {n : ℕ} → SimpleGraph.SphericalMap n → Fin n → Prop :=
fun {n} T r =>
  ∀ (c : Fin n → Fin 4),
    SimpleGraph.VacancySlide.ProperOff T.graph r c → ∃ m, SimpleGraph.VacancyShortFill.PureFill T.graph r c m
SimpleGraph.SphericalMap.four_color_of_RStarSupport : SimpleGraph.SphericalMap.RStarSupport →
  ∀ {n : ℕ} (M : SimpleGraph.SphericalMap n), M.graph.Colorable 4
'SimpleGraph.SphericalMap.four_color_of_RStarSupport' depends on axioms: [propext, Classical.choice, Quot.sound]

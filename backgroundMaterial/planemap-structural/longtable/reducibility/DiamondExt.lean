import Std.Tactic.BVDecide

/-!
# Birkhoff diamond: exact set of extendable ring colourings (generated by gen_lean.py)

Ring positions 0..5, interior vertices 0..3, same layout as StudioMathLean `DiamondCert.lean`
(`ringList = [[0,1],[1,2,3],[3,4],[0,4,5]]`, `intList = [[1,2,3],[0,2],[0,1,3],[0,2]]`).
Colours are `BitVec 2`.  `extSet r` says the ring colouring is (up to renaming) one of the 16
classes that `dred.py` finds extendable; there are 31 classes of proper ring colourings.

* `diamond_noext`  : (bv_decide) a proper ring colouring with a proper interior extension is in
  `extSet`; i.e. the other 15 classes do NOT extend.  SAT/UNSAT part, LRAT checked by the kernel.
* `diamond_ext_k`  : (bv_decide) for each extendable class an explicit extension (interior colours
  as XOR-terms of the ring colours) is proper.
* `diamond_ext_iff`: combined: for a proper ring colouring, extends ↔ extSet.
-/

namespace BirkhoffDiamond

/-- interior colouring `i` properly extends ring colouring `r`. -/
def IntProper (r0 r1 r2 r3 r4 r5 i0 i1 i2 i3 : BitVec 2) : Prop :=
  i0 ≠ r0 ∧ i0 ≠ r1 ∧ i0 ≠ i1 ∧ i0 ≠ i2 ∧ i0 ≠ i3 ∧ i1 ≠ r1 ∧ i1 ≠ r2 ∧ i1 ≠ r3 ∧ i1 ≠ i2 ∧ i2 ≠ r3 ∧ i2 ≠ r4 ∧ i2 ≠ i3 ∧ i3 ≠ r0 ∧ i3 ≠ r4 ∧ i3 ≠ r5

def RingProper (r0 r1 r2 r3 r4 r5 : BitVec 2) : Prop :=
  r0 ≠ r1 ∧ r1 ≠ r2 ∧ r2 ≠ r3 ∧ r3 ≠ r4 ∧ r4 ≠ r5 ∧ r5 ≠ r0

/-- the ring colouring is in one of the 16 extendable classes. -/
def ExtSet (r0 r1 r2 r3 r4 r5 : BitVec 2) : Prop :=
  (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 = r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 = r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 = r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 = r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 = r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5) ∨
  (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)

/-- The 15 non-extendable classes really do not extend (UNSAT, via LRAT). -/
theorem diamond_noext (r0 r1 r2 r3 r4 r5 i0 i1 i2 i3 : BitVec 2)
    (hr : RingProper r0 r1 r2 r3 r4 r5) (hi : IntProper r0 r1 r2 r3 r4 r5 i0 i1 i2 i3) :
    ExtSet r0 r1 r2 r3 r4 r5 := by
  simp only [RingProper, IntProper, ExtSet] at *
  bv_decide

/-- class 010121 extends: interior colours (2, 3, 0, 3) up to renaming. -/
theorem diamond_ext_0 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r4 (r0 ^^^ r1 ^^^ r4) r0 (r0 ^^^ r1 ^^^ r4) := by
  simp only [IntProper] at *
  bv_decide

/-- class 010123 extends: interior colours (2, 3, 0, 1) up to renaming. -/
theorem diamond_ext_1 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r4 r5 r0 r1 := by
  simp only [IntProper] at *
  bv_decide

/-- class 010201 extends: interior colours (2, 3, 1, 3) up to renaming. -/
theorem diamond_ext_2 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r3 (r0 ^^^ r1 ^^^ r3) r1 (r0 ^^^ r1 ^^^ r3) := by
  simp only [IntProper] at *
  bv_decide

/-- class 010202 extends: interior colours (2, 3, 1, 3) up to renaming. -/
theorem diamond_ext_3 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r3 (r0 ^^^ r1 ^^^ r3) r1 (r0 ^^^ r1 ^^^ r3) := by
  simp only [IntProper] at *
  bv_decide

/-- class 010212 extends: interior colours (2, 3, 0, 3) up to renaming. -/
theorem diamond_ext_4 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 = r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r3 (r0 ^^^ r1 ^^^ r3) r0 (r0 ^^^ r1 ^^^ r3) := by

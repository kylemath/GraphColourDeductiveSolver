theorem diamond_ext_14 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5)) :

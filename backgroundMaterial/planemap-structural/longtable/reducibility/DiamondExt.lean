  bv_decide

/-- class 010232 extends: interior colours (2, 3, 0, 1) up to renaming. -/
theorem diamond_ext_5 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 = r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r3 r4 r0 r1 := by
  simp only [IntProper] at *
  bv_decide

/-- class 012021 extends: interior colours (2, 3, 1, 3) up to renaming. -/
theorem diamond_ext_6 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 = r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r2 (r0 ^^^ r1 ^^^ r2) r1 (r0 ^^^ r1 ^^^ r2) := by
  simp only [IntProper] at *
  bv_decide

/-- class 012102 extends: interior colours (2, 0, 3, 1) up to renaming. -/
theorem diamond_ext_7 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 = r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r2 r0 (r0 ^^^ r1 ^^^ r2) r1 := by
  simp only [IntProper] at *
  bv_decide

/-- class 012103 extends: interior colours (2, 0, 3, 1) up to renaming. -/
theorem diamond_ext_8 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r2 r0 r5 r1 := by
  simp only [IntProper] at *
  bv_decide

/-- class 012121 extends: interior colours (2, 3, 0, 3) up to renaming. -/
theorem diamond_ext_9 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 = r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r2 (r0 ^^^ r1 ^^^ r2) r0 (r0 ^^^ r1 ^^^ r2) := by
  simp only [IntProper] at *
  bv_decide

/-- class 012123 extends: interior colours (2, 0, 3, 1) up to renaming. -/
theorem diamond_ext_10 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 = r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r2 r0 r5 r1 := by
  simp only [IntProper] at *
  bv_decide

/-- class 012132 extends: interior colours (2, 3, 0, 1) up to renaming. -/
theorem diamond_ext_11 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 ≠ r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 = r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 = r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r2 r4 r0 r1 := by
  simp only [IntProper] at *
  bv_decide

/-- class 012301 extends: interior colours (2, 0, 1, 3) up to renaming. -/
theorem diamond_ext_12 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 = r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 ≠ r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :
    IntProper r0 r1 r2 r3 r4 r5 r2 r0 r1 r3 := by
  simp only [IntProper] at *
  bv_decide

/-- class 012302 extends: interior colours (2, 0, 1, 3) up to renaming. -/
theorem diamond_ext_13 (r0 r1 r2 r3 r4 r5 : BitVec 2) (hm : (r0 ≠ r1 ∧ r0 ≠ r2 ∧ r0 ≠ r3 ∧ r0 = r4 ∧ r0 ≠ r5 ∧ r1 ≠ r2 ∧ r1 ≠ r3 ∧ r1 ≠ r4 ∧ r1 ≠ r5 ∧ r2 ≠ r3 ∧ r2 ≠ r4 ∧ r2 = r5 ∧ r3 ≠ r4 ∧ r3 ≠ r5 ∧ r4 ≠ r5)) :

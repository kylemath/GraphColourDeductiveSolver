    IntProper r0 r1 r2 r3 r4 r5 r2 r0 r1 r3 := by
  simp only [IntProper] at *
  bv_decide

/-- For a proper colouring of the 6-ring: it extends to the diamond interior iff it lies in the
16 classes of `ExtSet` (31 classes in all). -/
theorem diamond_ext_iff (r0 r1 r2 r3 r4 r5 : BitVec 2) (hr : RingProper r0 r1 r2 r3 r4 r5) :
    (∃ i0 i1 i2 i3 : BitVec 2, IntProper r0 r1 r2 r3 r4 r5 i0 i1 i2 i3) ↔ ExtSet r0 r1 r2 r3 r4 r5 := by
  constructor
  · rintro ⟨i0, i1, i2, i3, hi⟩
    exact diamond_noext r0 r1 r2 r3 r4 r5 i0 i1 i2 i3 hr hi
  · intro hs
    simp only [ExtSet] at hs
    rcases hs with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
    · exact ⟨r4, (r0 ^^^ r1 ^^^ r4), r0, (r0 ^^^ r1 ^^^ r4), diamond_ext_0 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r4, r5, r0, r1, diamond_ext_1 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r3, (r0 ^^^ r1 ^^^ r3), r1, (r0 ^^^ r1 ^^^ r3), diamond_ext_2 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r3, (r0 ^^^ r1 ^^^ r3), r1, (r0 ^^^ r1 ^^^ r3), diamond_ext_3 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r3, (r0 ^^^ r1 ^^^ r3), r0, (r0 ^^^ r1 ^^^ r3), diamond_ext_4 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r3, r4, r0, r1, diamond_ext_5 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, (r0 ^^^ r1 ^^^ r2), r1, (r0 ^^^ r1 ^^^ r2), diamond_ext_6 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, r0, (r0 ^^^ r1 ^^^ r2), r1, diamond_ext_7 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, r0, r5, r1, diamond_ext_8 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, (r0 ^^^ r1 ^^^ r2), r0, (r0 ^^^ r1 ^^^ r2), diamond_ext_9 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, r0, r5, r1, diamond_ext_10 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, r4, r0, r1, diamond_ext_11 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, r0, r1, r3, diamond_ext_12 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, r0, r1, r3, diamond_ext_13 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r3, r0, r1, r2, diamond_ext_14 r0 r1 r2 r3 r4 r5 h⟩
    · exact ⟨r2, r0, r1, r3, diamond_ext_15 r0 r1 r2 r3 r4 r5 h⟩

end BirkhoffDiamond


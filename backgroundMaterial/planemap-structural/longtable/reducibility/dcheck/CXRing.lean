import CGlue

/-!
# CXRing: the ring-X C entries as fold-safe data (Long Table, 19 Oct 2026)

Every C entry of `discharge/wheeldis/out/job30/k3x_C.cfast` whose contraction set `X` has a
ring–interior edge, with:
- the configuration the C verdict was computed on: the input line of the first `loop/k*/` cfast file
  that twoeng.py takes the entry's block from (`src`), with the same `r` and `m` as that block's header;
- `X` as recorded in `k3x_C.cfast`;
- the labelling with one label per X-component.

`xrEntries_ok` checks, by one `native_decide`, that every entry is admissible (`admissibleX`) and
fold-safe (`foldSafeX`), and has the side facts of `CEntry`. `XRData.toCEntryF` then turns an entry
into a `CEntryF` once its C verdict `hC : cReducible18 cf eqR eqI = true` is supplied. The `hC`
facts themselves are not computed here: they are the per-key Lean C checks, which take minutes to
hours each at rings 11–16.
-/

namespace SimpleGraph.SphericalMap.CGlue
open DCheck DCheck.R2

/-- One ring-X C entry: its configuration, X and labelling. -/
structure XRData where
  name : String
  /-- the cfast file the verdict comes from -/
  src : String
  /-- `X` as written in `k3x_C.cfast` -/
  X : String
  cf : DCheck18.Conf
  eqR : List (ℕ × ℕ)
  eqI : List (ℕ × ℕ)
  lbl : List ℕ

/-- The decidable side facts of a `CEntryF`, all but the C verdict. -/
def XRData.ok (d : XRData) : Bool :=
  admissibleX (Conf.of18 d.cf) d.eqR d.eqI d.lbl && foldSafeX (Conf.of18 d.cf) d.eqR d.eqI d.lbl &&
  decide (2 ≤ d.cf.r) && decide (d.cf.r ≤ 19) &&
  decide (∀ a b : Fin (Conf.of18 d.cf).m,
    intAdjOf (Conf.of18 d.cf) a b = true → intAdjOf (Conf.of18 d.cf) b a = true) &&
  decide (∀ a : Fin (Conf.of18 d.cf).m, intAdjOf (Conf.of18 d.cf) a a = false) &&
  decide (∀ a, a < d.cf.m → ∀ t ∈ d.cf.ringAdj[a]!, t < d.cf.r)

/-- An entry with `ok` and a C verdict is a fold-safe C entry. -/
def XRData.toCEntryF (d : XRData) (hok : d.ok = true)
    (hC : cReducible18 d.cf d.eqR d.eqI = true) : CEntryF := by
  simp only [XRData.ok, Bool.and_eq_true, decide_eq_true_eq] at hok
  obtain ⟨⟨⟨⟨⟨⟨hadm, hfold⟩, hr2⟩, hr⟩, hsym⟩, hloop⟩, hrr⟩ := hok
  exact { cf := d.cf, eqR := d.eqR, eqI := d.eqI, lbl := d.lbl, hC := hC, hadm := hadm,
          hr2 := hr2, hr := hr, hsym := hsym, hloop := hloop, hrr := hrr, hfold := hfold }


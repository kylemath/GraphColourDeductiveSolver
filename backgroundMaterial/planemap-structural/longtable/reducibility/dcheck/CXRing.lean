theorem xrEntries_length : xrEntries.length = 96 := by
  native_decide

/-- Each listed entry gives a `CEntryF` from its C verdict. -/
theorem xrEntries_fold (d : XRData) (hd : d ∈ xrEntries)
    (hC : cReducible18 d.cf d.eqR d.eqI = true) :
    ∃ e : CEntryF, e.cf = d.cf ∧ e.eqR = d.eqR ∧ e.eqI = d.eqI :=
  ⟨d.toCEntryF (List.all_eq_true.1 xrEntries_ok d hd) hC, rfl, rfl, rfl⟩

end SimpleGraph.SphericalMap.CGlue

#print axioms SimpleGraph.SphericalMap.CGlue.xrEntries_ok
#print axioms SimpleGraph.SphericalMap.CGlue.xrEntries_fold

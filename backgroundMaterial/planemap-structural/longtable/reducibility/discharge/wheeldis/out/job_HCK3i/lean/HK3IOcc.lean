open SimpleGraph SimpleGraph.SphericalMap SimpleGraph.SphericalMap.CGlue DCheck

namespace HK3IOcc

variable {n : ℕ}

/-- The fold-safe C entry `k` of `CGlue.k3iEntries`, with Studio's `hC`. -/
def cEntry (k : Fin 2) : CEntryF :=
  (k3iEntries.get (k.cast k3iEntries_length.symm)).toCEntryF
    (List.all_eq_true.1 k3iEntries_ok _ (List.get_mem _ _)) (K3IV.hC_all k)


theorem rsstParts_length : rsstParts.length = 71 := by decide

/-- By number of subparts: 6 with 5, 14 with 6, 40 with 7 and 11 with 8 (spec §3.2). -/
theorem rsstParts_count_by_hub :
    (rsstParts.filter (·.hub == 5)).length = 6 ∧ (rsstParts.filter (·.hub == 6)).length = 14 ∧
    (rsstParts.filter (·.hub == 7)).length = 40 ∧ (rsstParts.filter (·.hub == 8)).length = 11 := by decide

/-- Shape facts: hub letter in `5..8` equal to the number of subparts, one unit to the third spoke, every range inside
`5..9`, and every non-`*` fan list on an exact 6..8 spoke with exactly `spoke − 5` entries (spec §3.2 last sentence). -/
def Part.wellShaped (p : Part) : Bool :=
  Nat.ble 5 p.hub && Nat.ble p.hub 8 && p.subs.length == p.hub && p.target == 2 && p.amount == 1 &&
  p.subs.all fun s =>
    let ok (r : Rng) := Nat.ble 5 r.lo && Nat.ble r.lo r.hi && Nat.ble r.hi 9
    ok s.spoke && ok s.hat && s.fans.all ok &&
    (s.fans.isEmpty || (s.spoke.exact68 && s.fans.length == s.spoke.lo - 5))

theorem rsstParts_wellShaped : rsstParts.all Part.wellShaped = true := by decide

end SimpleGraph.SphericalMap.RSSTSeed

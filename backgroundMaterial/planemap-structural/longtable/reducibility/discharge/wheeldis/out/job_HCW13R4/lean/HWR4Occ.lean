/-! # HWR4Occ (Opus, s76_occ502/hcw13r4, 6 Nov 2026): Studio's C verdicts `W4V.hC_all` on `CGlue.w4Entries` (job HCW13R4,
CW4.lean, EXTRAFILE from swarm commit 7e96e85a), as fold-safe registry entries `CEntryF` (`XRData.toCEntryF`, the CC3All pattern), tied
to the per-key occurrence modules `COccHWR4_kk` (s74_leanglue/gen_occ_kc.py, face-walk form). `colorable_k` is the per-key C reduction
from a rotation occurrence `Occ`. The `rfl` is `(cEntry k).cf = HWR4_kk.cf`: `toCEntryF` keeps `cf := d.cf`, and the two Conf literals
must be identical (run s76_occ502/scripts/check_literals_c.py on CW4.lean first). Generated by s76_occ502/scripts/gen_cocc_batch.py. -/

open SimpleGraph SimpleGraph.SphericalMap SimpleGraph.SphericalMap.CGlue DCheck

namespace HWR4Occ

variable {n : ℕ}

/-- The fold-safe C entry `k` of `CGlue.w4Entries`, with Studio's `hC`. -/
def cEntry (k : Fin 4) : CEntryF :=
  (w4Entries.get (k.cast w4Entries_length.symm)).toCEntryF
    (List.all_eq_true.1 w4Entries_ok _ (List.get_mem _ _)) (W4V.hC_all k)

/-- Entry 0, `b7_u55766.._66.5...` (ring 13, 9 interior vertices). -/
theorem colorable_0 {T : SphericalMap n} (htri : T.Triangulated) {ring : Fin 13 → Fin n}
    {int : Fin 9 → Fin n} (h : HWR4_00.Occ T ring int)
    (IH : ∀ (m' : ℕ) (N : SphericalMap m'), Nat.card N.graph.support < Nat.card T.graph.support →
      N.graph.Colorable 4) : T.graph.Colorable 4 :=
  HWR4_00.colorable_of_occ_centry (cEntry 0) rfl htri h IH

/-- The same for an occurrence of the mirror image. -/
theorem colorable_mirror_0 {T : SphericalMap n} (htri : T.Triangulated) {ring : Fin 13 → Fin n}
    {int : Fin 9 → Fin n} (h : HWR4_00.Occ T.mirror ring int)
    (IH : ∀ (m' : ℕ) (N : SphericalMap m'), Nat.card N.graph.support < Nat.card T.graph.support →
      N.graph.Colorable 4) : T.graph.Colorable 4 :=
  HWR4_00.colorable_of_mirror_occ_centry (cEntry 0) rfl htri h IH


/-! # HDCOcc (s74_leanglue/gen_occ_kc.py): gen_hd.py's verdicts `HDCV.hD_i` on `HDC.hdcConfs`, tied to the per-key
occurrence modules (`COcc<NS>`). `dEntry_i` is the `ClaimGlue.DEntry`; `colorable_i` is the per-key reduction from a
rotation occurrence `Occ` (face-walk ring by default). The `rfl` is `HDC.hdcConfs.get ⟨i, _⟩ = <NS>.cf` (same Conf literal). -/

open SimpleGraph SimpleGraph.SphericalMap

namespace HDCOcc

variable {n : ℕ}

/-- Entry 0, `nl0004_r8` (ring 8, 5 interior vertices). -/
def dEntry_0 : ClaimGlue.DEntry := HC_000.dEntryOf HDCV.hD_0 rfl

theorem colorable_0 {T : SphericalMap n} (htri : T.Triangulated) {ring : Fin 8 → Fin n}
    {int : Fin 5 → Fin n} (h : HC_000.Occ T ring int)
    (IH : ∀ (m' : ℕ) (N : SphericalMap m'), Nat.card N.graph.support < Nat.card T.graph.support →
      N.graph.Colorable 4) : T.graph.Colorable 4 :=
  HC_000.colorable_of_occ_entry HDCV.hD_0 rfl htri h IH


def xo_term(q): return q[2][4] != 0 and q[3][4] != 0 and any(ti != to for _, _, ti, to in xo_cands(q))
def xo_eff(q):
    """XQeff(q) = max over the candidates of xo[in] - xo[out] (the smallest XQ the mrowX rows allow)"""

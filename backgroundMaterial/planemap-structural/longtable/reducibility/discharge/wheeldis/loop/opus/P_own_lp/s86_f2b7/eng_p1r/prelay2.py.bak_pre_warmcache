        su[0] = deg['si']; su[1] = deg['sp1']; su[-1] = deg['sim']; su[-2] = deg['sm2']
        for k in range(du):
            if wu[k] is None: wu[k] = L()
            if su[k] is None: su[k] = L()
        wu[0] = V
